  - m_Id: 6168172360097792
    m_Localized: "\u0425\u043C, \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
      \u0442\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u0435\u0440\u0435\u0443\u0441\u043B\u043E\u0436\u043D\u044F\u0435\u0448\u044C
      \u044D\u0442\u0443 \u0437\u0430\u0433\u0430\u0434\u043A\u0443 \u0432 \u0441\u0432\u043E\u0435\u0439
      \u0433\u043E\u043B\u043E\u0432\u0435. \u0422\u0430\u043A\u043E\u0439 \u043F\u043E\u0434\u0445\u043E\u0434
      \u043D\u0435 \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0438\u043D\u0430\u0447\u0435
      \u043A\u0430\u043A \u0442\u0443\u043F\u0438\u043A. \u0422\u0438\u043F\u0438\u0447\u043D\u0430\u044F
      \u043E\u0448\u0438\u0431\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6168319555002368
    m_Localized: " \u0422\u0430\u043A \u0443\u0436 \u0438 \u0431\u044B\u0442\u044C,
