  m_TableData:
  - m_Id: 15522062336
    m_Localized: "\u0420\u0443\u0441\u0430\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 79791382528
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E
      \u0442\u0435\u0431\u044F \u0434\u043E\u0440\u043E\u0439 \u0434\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 287753363456
    m_Localized: "\u042F \u0431\u0443\u0434\u0443 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
      \u0442\u0435\u0431\u0435 \u0432 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 463624724480
    m_Localized: "\u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435 \u0442\u044B
      \u0431\u0443\u0434\u0435\u0448\u044C \u043D\u0430\u043F\u0440\u044F\u0433\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043D\u043E\u0433\u0438 \u0442\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435
      \u0442\u044B \u043F\u0440\u044B\u0433\u043D\u0435\u0448\u044C. \u0414\u0430\u0432\u0430\u0439
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1048777992429568
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446! \u042F \u0442\u0430\u043A
      \u0440\u0430\u0434\u0430 \u0447\u0442\u043E \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1048876034285568
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0437\u0430\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0439
      \u043A\u043E \u043C\u043D\u0435 \u0432 \u0437\u0430\u043C\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1083493953036288
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E
      \u0442\u0435\u0431\u044F \u0432 \u043C\u043E\u0435\u043C \u0437\u0430\u043C\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1083608327512064
    m_Localized: "\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043A\u0430 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F
      \u0431\u0443\u0434\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 3526086571278336
    m_Localized: "\u042D\u0442\u043E \u0441\u0442\u0430\u0442\u0443\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3526264946638848
    m_Localized: "\u042D\u0442\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u0442\u0430\u0442\u0443\u044F
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3526448585850880
    m_Localized: "\u0414\u0430 \u044D\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 3526682749648896
    m_Localized: "\u042D\u0442\u043E \u0441\u0442\u0430\u0442\u0443\u044F \u0437\u0432\u0435\u0437\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3526769441718272
    m_Localized: "\u0414\u0430 \u044D\u0442\u043E \u0437\u0432\u0435\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3526795144413184
    m_Localized: "\u042D\u0442\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u0442\u0430\u0442\u0443\u044F
      \u0437\u0432\u0435\u0437\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3526821950210048
    m_Localized: "\u042D\u0442\u043E \u0441\u0442\u0430\u0442\u0443\u044F \u043A\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3526864027467776
    m_Localized: "\u041F\u043E \u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u044D\u0442\u043E
      \u0441\u0442\u0430\u0442\u0443\u044F \u043A\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3526884361453568
    m_Localized: "\u0422\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u0447\u0442\u043E
      \u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F? \u042D\u0442\u043E
      \u0441\u0442\u0430\u0442\u0443\u044F \u043A\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3526903089020928
    m_Localized: "\u042D\u0442\u043E \u0441\u0442\u0430\u0442\u0443\u044F \u043C\u0435\u0434\u0443\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3527032600739840
    m_Localized: "\u042D\u0442\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u0442\u0430\u0442\u0443\u044F
      \u043C\u0435\u0434\u0443\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3527060505444352
    m_Localized: "\u0422\u044B \u0414\u0443\u043C\u0430\u0435\u0448\u044C \u0447\u0442\u043E
      \u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F?
      \u042D\u0442\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u0442\u0430\u0442\u0443\u044F
      \u043C\u0435\u0434\u0443\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3539205779570688
    m_Localized: "\u0418\u0442\u0430\u043A, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u044F \u043E\u0442\u043A\u0440\u043E\u044E \u0434\u0432\u0435\u0440\u044C,
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u0437\u043D\u0430\u0442\u044C
      \u043A\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0442\u044B \u0438\u0437\u0443\u0447\u0438\u043B
      \u043C\u043E\u0439 \u0437\u0430\u043C\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 3539363950968832
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u044C
      \u043C\u043D\u0435 \u043D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435
      \u0441\u0442\u0430\u0442\u0443\u0438 \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3539590728597504
    m_Localized: "\u041F\u0435\u0440\u0432\u043E\u0435 \u043D\u0430 \u0447\u0442\u043E
      \u0442\u044B \u043C\u043D\u0435 \u0443\u043A\u0430\u0436\u0435\u0448\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445. \u0423 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0435\u0442 \u043C\u043E\u0437\u0433\u043E\u0432. \u0422\u0440\u0435\u0442\u0438\u0439
      \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0445\u043E\u0434\u0430\u043C\u0438.
      \u0427\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439 \u0436\u0438\u0432\u0435\u0442
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 3540307388350464
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u043D\u0430\u0436\u043C\u0435\u0448\u044C
      \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435
      \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0434\u0432\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3558816268894208
    m_Localized: "\u041A\u0430\u043A \u044F \u0443\u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0430 \u0441\u0442\u0430\u0442\u0443\u0438. \u041F\u0435\u0440\u0432\u0430\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445, \u0443 \u0432\u0442\u043E\u0440\u043E\u0439
      \u043D\u0435\u0442 \u043C\u043E\u0437\u0433\u043E\u0432, \u0442\u0440\u0435\u0442\u044C\u044F
      \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0445\u043E\u0434\u0430\u043C\u0438,
      \u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0430\u044F \u0436\u0438\u0432\u0435\u0442
      \u043D\u0430 \u043F\u043E\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 5700960261718016
    m_Localized: "\u0423\u0440\u0430! \u0422\u044B \u0442\u0430\u043A\u043E\u0439
      \u043C\u043E\u043B\u043E\u0434\u0435\u0446 \u043A\u043E\u043D\u0435\u0447\u043D\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0436\u0438\u0432\u0435\u0442 \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0439\u0442\u0438
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5701090520023040
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0442\u0432\u043E\u0435 \u044D\u0433\u043E
      \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445, \u043D\u043E
      \u043C\u044B \u0442\u0443\u0442 \u0441\u043C\u043E\u0442\u0440\u0438\u043C
      \u043D\u0430 \u0440\u0430\u0437\u043C\u0435\u0440\u044B. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
      \u043E\u0442\u0432\u0435\u0442 \u0431\u044B\u043B \u043A\u0438\u0442! \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B\u0431\u0435\u0440\u0438 \u0442\u043E\u0433\u043E \u0443 \u043A\u043E\u0433\u043E
      \u043D\u0435\u0442 \u043C\u043E\u0437\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5701267070861312
    m_Localized: "\u0425\u0430\u0445\u0430\u0445\u0430. \u041A\u0443\u0448\u0430\u0435\u0448\u044C
      \u043E\u0442\u0445\u043E\u0434\u044B? \u042D\u0442\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u043E\u0442\u0432\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438
      \u0442\u044B \u043D\u0435 \u0441\u0432\u0438\u043D\u044E\u0448\u043A\u0430.
      \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u0437\u0432\u0435\u0437\u0434\u0430,
      \u041F\u041E\u0421\u041B\u0415\u0414\u041D\u0418\u0419 \u0412\u041E\u041F\u0420\u041E\u0421
      \u041A\u0422\u041E \u0416\u0418\u0412\u0415\u0422 \u041D\u0410 \u041F\u041E\u0412\u0415\u0420\u0425\u041D\u041E\u0421\u0422\u0418?"
    m_Metadata:
      m_Items: []
  - m_Id: 5702162986778624
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0443 \u0442\u0435\u0431\u044F
      \u0438 \u043D\u0435\u0442 \u043C\u043E\u0437\u0433\u043E\u0432, \u043D\u043E
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u043E\u0431\u044B\u0447\u043D\u043E
      \u043E\u043D\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F.
      \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u043C\u0435\u0434\u0443\u0437\u0430.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0441\u0442\u0430\u0442\u0443\u044F
      \u0442\u0430 \u0447\u0442\u043E \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442\u0445\u043E\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5705838396653568
    m_Localized: "\u041D\u0443 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0436\u0438\u0432\u0443\u0442 \u0434\u0440\u0443\u0433\u0438\u0435 \u043C\u0435\u0434\u0443\u0437\u044B.
      \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u043C\u043E\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430
      \u0433\u043E\u0440\u0433\u043E\u043D\u0430. \u042D\u0445... \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u044B\u043D\u0439
      \u043E\u0442\u0432\u0435\u0442 \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 5706358284828672
    m_Localized: "\u041E\u0442\u0445\u043E\u0434\u0430\u043C\u0438 \u043E\u043D\u0430
      \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
      \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
      \u0438 \u0434\u0430\u0436\u0435 \u043D\u0435 \u043E \u0447\u0435\u043C \u043D\u0435
      \u0434\u0443\u043C\u0430\u0435\u0442. \u041E\u0442\u0432\u0435\u0442 \u0431\u044B\u043B
      \u043C\u043E\u0440\u0441\u043A\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430.
      \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438
      \u0441\u0442\u0430\u0442\u0443\u044E \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0436\u0438\u0432\u0435\u0442 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5706706890211328
    m_Localized: "\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u0447\u0442\u043E
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      \u043D\u0430 \u0441\u0442\u0430\u0442\u0443\u044E \u043C\u0435\u0434\u0443\u0437\u044B
      \u043E\u043D\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0439.
      \u041D\u043E \u043C\u044B \u043E\u0431\u0430 \u0441 \u0442\u043E\u0431\u043E\u0439
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u043C \u0447\u0442\u043E \u0432
      \u0436\u0438\u0437\u043D\u0438 \u043C\u0435\u0434\u0443\u0437\u0430 \u043D\u0435
      \u0442\u0430\u043A\u0430\u044F \u0443\u0436 \u0431\u043E\u043B\u044C\u0448\u0430\u044F.
      \u041E\u0442\u0432\u0435\u0442 \u0431\u044B\u043B \u043A\u0438\u0442. \u041B\u0430\u0434\u043D\u043E
