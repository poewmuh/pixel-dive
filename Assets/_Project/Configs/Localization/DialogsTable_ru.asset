  - m_Id: 5708407437213696
    m_Localized: "\u0422\u044B \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u043C\u043D\u0438\u0447\u043A\u0430!
      \u041A\u043E\u043D\u0435\u0447\u043D\u043E \u0437\u0432\u0435\u0437\u0434\u0430
      \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0445\u043E\u0434\u0430\u043C\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438 \u0442\u043E\u0433\u043E
      \u043A\u0442\u043E \u0436\u0438\u0432\u0435\u0442 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5708647552729088
    m_Localized: "\u0422\u044B \u0441\u043F\u0443\u0442\u0430\u043B \u0441\u043E
      \u0437\u0432\u0435\u0437\u0434\u043E\u0439 \u0432 \u043D\u0435\u0431\u0435?
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442
      \u0431\u044B\u043B \u043A\u0438\u0442. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B\u0431\u0435\u0440\u0438 \u0442\u043E\u0433\u043E \u0443 \u043A\u043E\u0433\u043E
      \u043D\u0435\u0442 \u043C\u043E\u0437\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5708986045644800
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A \u0442\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u043C\u043E\u0437\u0433\u0430 \u0443 \u0437\u0432\u0435\u0437\u0434\u044B
      \u043D\u0435\u0442. \u041D\u043E \u0443 \u043D\u0435\u0435 \u0435\u0441\u0442\u044C
      \u043D\u0435\u0440\u0432\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u0435\u0439 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438 \u0442\u043E\u0433\u043E
      \u043A\u0442\u043E \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0445\u043E\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5709555766345728
    m_Localized: "\u041A\u0438\u0442? \u041D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438?
      \u0422\u044B \u0443\u0432\u0435\u0440\u0435\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 5709823715262464
    m_Localized: "\u041D\u0443 \u043E\u0431\u044B\u0447\u043D\u043E \u043A\u0438\u0442\u044B
      \u043F\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0436\u0438\u0432\u044B\u043C\u0438
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430\u043C\u0438. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
      \u043E\u0442\u0432\u0435\u0442 \u0437\u0432\u0435\u0437\u0434\u0430. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B\u0431\u0435\u0440\u0438 \u0442\u043E\u0433\u043E \u043A\u0442\u043E
      \u0436\u0438\u0432\u0435\u0442 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5710169825034240
    m_Localized: "\u0414\u0430 \u0442\u044B \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u043F\u0440\u0430\u0432! \u041A\u0438\u0442 \u0441\u0430\u043C\u044B\u0439
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0437\u0434\u0435\u0441\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438 \u0442\u043E\u0433\u043E
      \u0443 \u043A\u043E\u0433\u043E \u043D\u0435\u0442 \u043C\u043E\u0437\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 5710375366901760
    m_Localized: "\u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443
      \u043A\u0438\u0442\u044B \u0443\u043C\u043D\u0435\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439... \u0423 \u043A\u0438\u0442\u0430 \u0435\u0441\u0442\u044C
      \u043C\u043E\u0437\u0433\u0438, \u0430 \u0432\u043E\u0442 \u0443 \u043C\u0435\u0434\u0443\u0437\u044B
      \u0438\u0445 \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E
      \u043D\u0435\u0442. \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438
      \u0442\u043E\u0433\u043E \u043A\u0442\u043E \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442\u0445\u043E\u0434\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5713659188166656
    m_Localized: "\u0425\u043E\u0442\u044C \u0438 \u0441 \u043E\u0448\u0438\u0431\u043A\u0430\u043C\u0438,
      \u043D\u043E \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F,
      \u044F \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u044E \u0442\u0435\u0431\u0435
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435,
      \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5713818726907904
    m_Localized: "\u0422\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
